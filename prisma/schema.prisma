generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./db.db"
}

model Student {
  id             String   @id @default(cuid())
  name           String
  phone          String   @unique
  grade          Int
  board          String
  field          String
  status         String   @default("free")
  startDate      DateTime
  targetDate     DateTime
  currentDay     Int      @default(1)
  totalDays      Int      @default(438)
  topicsDone     Int      @default(0)
  daysLeft       Int      @default(438)
  pacingGoal     String   @default("5M")
  pin            String   @default("1234")
  academicGroup  String   @default("Pre-Medical")
  topicsPerDay   Int      @default(4)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Subject {
  id               String    @id @default(cuid())
  name             String
  grade            String
  board            String
  field            String
  totalTopics      Int
  chapterCount     Int
  color            String
  icon             String
  order            Int       @default(0)
  groupEligibility String    @default("Both")
  chapters         Chapter[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Chapter {
  id        String   @id @default(cuid())
  subjectId String
  number    Int
  name      String
  topics    Topic[]
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Topic {
  id         String   @id @default(cuid())
  chapterId  String
  number     Int
  name       String
  videoLink  String   @default("")
  pdfLink    String   @default("")
  isFree     Boolean  @default(true)
  dayNumber  Int      @default(0)
  chapter    Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  progress   Progress[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Progress {
  id             String   @id @default(cuid())
  topicId        String
  studentPhone   String
  completed      Boolean  @default(false)
  dateCompleted  DateTime?
  topic          Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([topicId, studentPhone])
}

model SpecialCourse {
  id        String   @id @default(cuid())
  name      String
  subject   String
  topic     String
  videoLink String   @default("")
  pdfLink   String   @default("")
  grade     String
  board     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Config {
  id    String @id @default(cuid())
  key   String @unique
  value String
}
