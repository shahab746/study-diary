# ─── Authentication ────────────────────────────────────
NEXTAUTH_SECRET=your-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# ─── Supabase (Users + Progress) ──────────────────────
# Get these from: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Google Sheets (Curriculum read-only) ─────────────
# The default sheet ID is hardcoded in src/lib/sheet-sync.ts
# Only override if you have a custom curriculum sheet
# GOOGLE_SHEET_ID=your-custom-sheet-id
